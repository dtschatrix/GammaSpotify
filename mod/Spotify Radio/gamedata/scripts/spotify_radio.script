--[[
	Spotify Radio - game side.

	Talks to the Spotify Radio daemon; the daemon talks to Spotify. This script is the remote
	control (state, search, playlists, transport). spotify_radio_stream.script plays the music
	through the game engine.

	Link to the daemon: two text files in the game's appdata folder
	(spotify_radio_cmd.txt = commands from the game, spotify_radio_out.txt = replies).
	The engine only exposes LuaSocket when "lua_debug 1" is set, so files are the default;
	set PREFER_SOCKET = true to use TCP instead when it is available.

	Other scripts can use:
		spotify_radio.send("next")            -- any daemon command
		spotify_radio.search("burial")        -- results arrive in spotify_radio.results
		spotify_radio.play_uri(uri)
		spotify_radio.switch_source("youtube")  -- "spotify" / "youtube", when the daemon has both
		spotify_radio.seek(90000)               -- ms into the current track
		spotify_radio.subscribe(function(event, data) ... end)   -- "state" / "results" / "error"

	The PDA screen lives in spotify_radio_ui.script.
]]

-- ===================================================================== settings
local PREFER_SOCKET = false
local HOST = "127.0.0.1"
local PORT = 47800               -- must match gamePort in the daemon's config.json

local CMD_FILE = "spotify_radio_cmd.txt"   -- in appdata; must match the daemon
local OUT_FILE = "spotify_radio_out.txt"

-- Optional hotkeys, off by default (everything is in the PDA radio tab).
-- Example: toggle = "DIK_F6". Actions: toggle, next, prev, vol_up, vol_down, show.
local KEYS = {
}
local VOLUME_STEP     = 10
local PUMP_MS         = 150      -- how often replies are read
local PING_MS         = 4000     -- file link: how often the daemon is pinged
local ALIVE_MS        = 12000    -- file link: daemon counts as gone after this much silence
local CONNECT_TIMEOUT = 0.02     -- socket link: seconds
local RETRY_MS        = 10000    -- socket link: pause between automatic connection attempts
local MAX_AUTO_TRIES  = 6

-- ===================================================================== state
state = {
	status = "offline",          -- offline | playing | paused | idle | nodevice
	artist = "", title = "", uri = "",
	progress = 0, duration = 0,  -- ms
	volume = -1, device = "", shuffle = false,
	source = "",                 -- what the game hears: spotify | youtube ("" from an older daemon)
	sources = {},                -- what the PDA's switch offers: { "spotify", "youtube" }
	received_at = 0,             -- time_global() of the last update
}
-- What the PDA shows: the same as state, except that when the music runs through the game
-- the track and position are those of the audio being heard, which is seconds behind Spotify.
shown = { status = "offline", artist = "", title = "", progress = 0, duration = 0, volume = -1,
          device = "", shuffle = false, uri = "", received_at = 0, heard = false, source = "" }
heard = function() return nil end -- replaced by spotify_radio_stream: track and position being heard
local status_until = 0           -- a button was pressed: shown.status is ahead of Spotify until then
local source_until = 0           -- the switch was flipped: shown.source is ahead of the daemon until then
local seek_to, seek_at, seek_until = 0, 0, 0  -- a seek was asked for: the daemon's time may still be the old one

results = {}                     -- last search / playlist listing: { {kind=, uri=, title=, subtitle=}, ... }
results_title = ""
results_version = 0              -- bumped whenever results change
upnext = {}                      -- what plays after the current track, in order: { {kind=, uri=, title=, subtitle=}, ... }
upnext_source = ""               -- whose list that is: spotify | youtube
upnext_version = 0               -- bumped whenever it arrives
last_error = ""
last_error_at = 0                -- time_global() of the last error
link_mode = "none"               -- none | file | socket (for display)

local rx = ""
local pending_results
local pending_upnext
local next_pump_at = 0
local listeners = {}
local key_to_action = {}
local announce_next_state = false

-- file link
local cmd_path, out_path
local out_offset = 0
local alive = false
local last_rx_at = 0
local next_ping_at = 0

-- socket link
local sock_lib, sock_lib_failed
local sock
local next_connect_at = 0
local auto_tries = 0

-- ===================================================================== helpers
local function log(msg)
	printf("[spotify_radio] %s", tostring(msg))
end

local function show(msg)
	log(msg)
	if not (db and db.actor) then return end
	local ok = pcall(function() actor_menu.set_msg(1, msg, 4) end)
	if not ok then
		pcall(function() news_manager.send_tip(db.actor, msg, nil, nil, 5000) end)
	end
end

local function set_error(msg)
	last_error, last_error_at = msg, time_global()
end

local function notify(event, data)
	for i = 1, #listeners do
		local ok, err = pcall(listeners[i], event, data)
		if not ok then log("listener error: " .. tostring(err)) end
	end
end

local function split_tabs(line)
	local t = {}
	for field in (line .. "\t"):gmatch("(.-)\t") do
		t[#t + 1] = field
	end
	return t
end

-- "Spotify" or "YouTube": what the game hears (Spotify for an older daemon).
function source_name()
	return shown.source == "youtube" and "YouTube" or "Spotify"
end

function now_playing_text()
	local src = source_name()
	if shown.status == "offline" then return "Spotify: daemon not connected" end
	if shown.status == "nodevice" then return "Spotify: nothing active - open the Spotify app" end
	if shown.title == "" then return src .. ": nothing playing" end
	local name = shown.artist ~= "" and (shown.artist .. " - " .. shown.title) or shown.title
	if shown.status == "paused" then return src .. " (paused): " .. name end
	return src .. ": " .. name
end

-- Position in the track, in ms.
function shown_position()
	local pos = shown.progress
	if not shown.heard and shown.status == "playing" then pos = pos + (time_global() - shown.received_at) end
	return math.max(0, math.min(shown.duration, pos))
end

-- Brings "shown" up to date. True when another track is now playing.
local function show_track()
	local old = shown.uri
	local m, pos = heard()
	if m then
		shown.artist, shown.title, shown.uri, shown.duration = m.artist, m.title, m.uri, m.duration
		shown.progress, shown.received_at, shown.heard = pos, time_global(), true
	else
		shown.artist, shown.title, shown.uri, shown.duration = state.artist, state.title, state.uri, state.duration
		shown.progress, shown.received_at, shown.heard = state.progress, state.received_at, false
	end
	return shown.uri ~= old and shown.uri ~= "" and shown.status == "playing"
end

-- A button was pressed in the PDA: show the result without waiting for Spotify.
function expect_status(status)
	if shown.status ~= "playing" and shown.status ~= "paused" then return end
	shown.status = status
	status_until = time_global() + 2000
end

local function go_offline(reason)
	if state.status ~= "offline" then log("daemon link lost: " .. tostring(reason)) end
	rx = ""
	pending_results, pending_upnext = nil, nil
	upnext, upnext_version = {}, upnext_version + 1
	state.status = "offline"
	shown.status = "offline"
	notify("state", state)
end

-- ===================================================================== protocol
local function on_state(f)
	local old_status = state.status
	state.status   = f[2] or "idle"
	state.artist   = f[3] or ""
	state.title    = f[4] or ""
	state.progress = tonumber(f[5]) or 0
	if time_global() < seek_until and math.abs(state.progress - seek_to) > 3000 then
		state.progress = seek_to + (f[2] == "playing" and time_global() - seek_at or 0)   -- from before the seek
	end
	state.duration = tonumber(f[6]) or 0
	state.volume   = tonumber(f[7]) or -1
	state.device   = f[8] or ""
	state.shuffle  = f[9] == "1"
	state.uri      = f[10] or ""
	state.source   = f[11] or ""
	state.sources  = {}
	for name in (f[12] or ""):gmatch("[^,]+") do state.sources[#state.sources + 1] = name end
	state.received_at = time_global()

	shown.volume, shown.device, shown.shuffle = state.volume, state.device, state.shuffle
	if time_global() >= source_until or shown.source == state.source then
		shown.source, source_until = state.source, 0
	end
	if time_global() >= status_until or shown.status == state.status then
		shown.status, status_until = state.status, 0
	end
	local track_changed = show_track()
	local resumed = old_status ~= "playing" and state.status == "playing" and old_status ~= "offline"
	if announce_next_state or track_changed or resumed then
		announce_next_state = false
		show(now_playing_text())
	end
	notify("state", state)
end

local function handle_line(line)
	local f = split_tabs(line)
	local kind = f[1]
	if kind == "state" then
		on_state(f)
	elseif kind == "error" then
		announce_next_state = false
		set_error(f[2] or "Spotify: error")
		show(last_error)
		notify("error", f[2])
	elseif kind == "results_begin" then
		pending_results = { title = f[2] or "", items = {} }
	elseif kind == "result" and pending_results then
		local items = pending_results.items
		items[#items + 1] = { kind = f[3] or "", uri = f[4] or "", title = f[5] or "", subtitle = f[6] or "" }
	elseif kind == "results_end" and pending_results then
		results, results_title = pending_results.items, pending_results.title
		results_version = results_version + 1
		pending_results = nil
		log(string.format("%d results for '%s'", #results, results_title))
		notify("results", results)
	elseif kind == "upnext_begin" then
		pending_upnext = { source = f[2] or "", items = {} }
	elseif kind == "upnext_item" and pending_upnext then
		local items = pending_upnext.items
		items[#items + 1] = { kind = f[3] or "", uri = f[4] or "", title = f[5] or "", subtitle = f[6] or "" }
	elseif kind == "upnext_end" and pending_upnext then
		upnext, upnext_source = pending_upnext.items, pending_upnext.source
		upnext_version = upnext_version + 1
		pending_upnext = nil
	elseif kind == "hello" then
		log("daemon says hello (protocol " .. tostring(f[3]) .. ")")
	elseif kind ~= "pong" and kind ~= "ok" then
		notify("line", f)                -- anything else is for other scripts (spotify_radio_stream)
	end
end

local function consume_lines()
	while true do
		local nl = rx:find("\n", 1, true)
		if not nl then break end
		local line = rx:sub(1, nl - 1)
		rx = rx:sub(nl + 1)
		if line:sub(-1) == "\r" then line = line:sub(1, -2) end
		if line ~= "" then
			local ok, perr = pcall(handle_line, line)
			if not ok then log("bad line from daemon: " .. tostring(perr)) end
		end
	end
end

-- ===================================================================== file link
local function file_init()
	local fs = getFS()
	cmd_path = fs:update_path("$app_data_root$", CMD_FILE)
	out_path = fs:update_path("$app_data_root$", OUT_FILE)
	-- skip whatever an earlier session left in the reply file
	local f = io.open(out_path, "rb")
	if f then
		out_offset = f:seek("end") or 0
		f:close()
	end
	link_mode = "file"
	log("file link: " .. tostring(cmd_path))
end

local function file_write(line)
	local f, err = io.open(cmd_path, "a")
	if not f then
		set_error("Cannot write " .. CMD_FILE)
		log("cannot open " .. tostring(cmd_path) .. ": " .. tostring(err))
		return false
	end
	f:write(line, "\n")
	f:close()
	return true
end

local function file_pump(now)
	local f = io.open(out_path, "rb")
	if f then
		local size = f:seek("end") or 0
		if size < out_offset then out_offset = 0 end          -- daemon reset the file
		if size > out_offset then
			f:seek("set", out_offset)
			local data = f:read(size - out_offset)
			if data and #data > 0 then
				out_offset = out_offset + #data
				rx = rx .. data
				last_rx_at = now
				if not alive then
					alive = true
					log("daemon is answering")
					file_write("hello")
				end
			end
		end
		f:close()
	end
	consume_lines()

	if alive and now - last_rx_at > ALIVE_MS then
		alive = false
		go_offline("no answer")
	end
	if now >= next_ping_at then
		next_ping_at = now + PING_MS
		file_write("ping")
	end
end

-- ===================================================================== socket link
local function load_lib()
	if sock_lib then return sock_lib end
	if sock_lib_failed then return nil end
	local ok, lib = pcall(require, "socket.core")
	if ok and type(lib) == "table" and lib.tcp then
		sock_lib = lib
		return lib
	end
	sock_lib_failed = true
	log("LuaSocket is not available, using the file link")
	return nil
end

local function sock_drop(reason)
	if sock then
		pcall(function() sock:close() end)
		sock = nil
	end
	go_offline(reason)
end

local function sock_connect()
	if sock then return true end
	local s = sock_lib.tcp()
	if not s then return false end
	s:settimeout(CONNECT_TIMEOUT)
	if not s:connect(HOST, PORT) then
		s:close()
		return false
	end
	s:settimeout(0)
	pcall(function() s:setoption("tcp-nodelay", true) end)
	sock = s
	rx = ""
	auto_tries = 0
	log("connected to daemon on " .. HOST .. ":" .. PORT)
	sock:send("hello\n")
	return true
end

local function sock_pump(now)
	if not sock then
		if auto_tries < MAX_AUTO_TRIES and now >= next_connect_at then
			auto_tries = auto_tries + 1
			next_connect_at = now + RETRY_MS
			sock_connect()
		end
		return
	end
	while sock do
		local data, err, partial = sock:receive(4096)
		local chunk = data or partial
		if chunk and #chunk > 0 then rx = rx .. chunk end
		if err and err ~= "timeout" then
			sock_drop(err)
			return
		end
		if not data then break end
	end
	consume_lines()
end

-- ===================================================================== link selection
local function ensure_link()
	if link_mode ~= "none" then return end
	if PREFER_SOCKET and load_lib() then
		link_mode = "socket"
		log("socket link: " .. HOST .. ":" .. PORT)
	else
		file_init()
	end
end

local function raw_send(line)
	ensure_link()
	if link_mode == "socket" then
		if not sock and not sock_connect() then return false end
		local sent, err = sock:send(line .. "\n")
		if not sent and err ~= "timeout" then
			sock_drop(err)
			return false
		end
		return true
	end
	return file_write(line) and alive
end

-- ===================================================================== public API
function is_connected()
	if link_mode == "socket" then return sock ~= nil end
	return alive
end

function send(cmd)
	if not raw_send(cmd) then
		if last_error == "" or time_global() - last_error_at > 1000 then
			set_error("Daemon is not running - start run.bat")
		end
		show("Spotify: daemon is not running")
		return false
	end
	return true
end

-- Like send(), but never nags the player when the daemon is away.
function tell(cmd)
	return raw_send(cmd)
end

-- Called when the PDA tab opens: refresh what is playing, without nagging if the daemon is down.
function on_tab_opened()
	raw_send(is_connected() and "state" or "hello")
end

function search(query)
	query = tostring(query or ""):gsub("[\t\r\n]", " ")
	return send("search " .. query)
end

function play_uri(uri)
	return send("playuri " .. tostring(uri))
end

function queue_uri(uri)
	return send("queue " .. tostring(uri))
end

function request_playlists()
	return send("playlists")
end

-- Jumps to ms in the current track. The PDA shows the new time at once.
function seek(ms)
	ms = math.max(0, math.floor(ms))
	if not send("seek " .. ms) then return false end
	seek_to, seek_at, seek_until = ms, time_global(), time_global() + 2500
	state.progress, state.received_at = ms, time_global()
	shown.progress, shown.received_at, shown.heard = ms, time_global(), false
	return true
end

-- Empties the list (the PDA shows its "Search ..." hint again).
function clear_results()
	results, results_title = {}, ""
	results_version = results_version + 1
end

-- Asks what plays next (the answer fills spotify_radio.upnext). Never nags when the daemon is away.
function request_upnext()
	return tell("upnext")
end

-- Takes entry i (0-based) of the up-next list out; YouTube only, Spotify's API cannot.
function unqueue(index, uri)
	return send("unqueue " .. index .. " " .. tostring(uri))
end

-- The daemon has Spotify and YouTube, both able to play in the game.
function can_switch()
	return #state.sources >= 2
end

-- The PDA's switch: "spotify" or "youtube". The daemon is told what is being heard on the source
-- that is left, so that switching back carries on from there.
function switch_source(name)
	if name == shown.source then return true end
	local line = "source " .. name
	local m, pos = heard()
	if m and m.uri ~= "" and not m.uri:find("%s") then line = line .. " " .. m.uri .. " " .. math.floor(pos) end
	if not send(line) then return false end
	shown.source, source_until = name, time_global() + 3000
	return true
end

function subscribe(fn)
	listeners[#listeners + 1] = fn
end

-- ===================================================================== game callbacks
local actions = {
	toggle   = function() send("toggle") end,
	next     = function() send("next") end,
	prev     = function() send("prev") end,
	vol_up   = function() send("volrel " .. VOLUME_STEP) end,
	vol_down = function() send("volrel -" .. VOLUME_STEP) end,
	show     = function()
		announce_next_state = true
		if not send("state") then announce_next_state = false end
	end,
}

local function on_key_press(key)
	local action = key_to_action[key]
	if action then actions[action]() end
end

local function actor_on_update()
	local now = time_global()
	if now < next_pump_at then return end
	next_pump_at = now + PUMP_MS

	ensure_link()
	if link_mode == "socket" then
		sock_pump(now)
	else
		file_pump(now)
	end
	if show_track() then show(now_playing_text()) end
end

local function actor_on_net_destroy()
	if sock then
		pcall(function() sock:close() end)
		sock = nil
	end
end

function on_game_start()
	for action, key_name in pairs(KEYS) do
		local code = DIK_keys and DIK_keys[key_name]
		if code then key_to_action[code] = action end
	end
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end
