	</btn_vol_up>
	<btn_shuffle x="724" y="184" width="48" height="30" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_shuffle</texture>
	</btn_shuffle>

	<btn_search x="46" y="240" width="100" height="28" stretch="1" check_mode="0">
