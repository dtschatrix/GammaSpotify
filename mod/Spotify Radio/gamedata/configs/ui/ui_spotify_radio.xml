<w>
	<!-- ============================ PDA tab ============================ -->
	<!-- The PDA's own tab bar sits above y=137, so everything lives below it. -->
	<frame_head x="28" y="137" width="764" height="88" stretch="1">
		<texture>ui_inGame2_pda_buttons_background</texture>
	</frame_head>

	<frame_list x="28" y="229" width="764" height="479" stretch="1">
		<texture>ui_inGame2_pda_buttons_background</texture>
	</frame_list>

	<title x="46" y="145" width="200" height="18">
		<text font="letterica16" r="30" g="215" b="96" a="255" vert_align="c">SPOTIFY</text>
	</title>

	<now_playing x="46" y="162" width="540" height="24">
		<text font="letterica18" r="220" g="220" b="220" a="255" vert_align="c"/>
	</now_playing>

	<status x="46" y="190" width="540" height="20">
