		<texture>ui_button_ordinary</texture>
	</btn_search>
	<btn_playlists x="152" y="240" width="100" height="28" stretch="1" check_mode="0">
		<text font="letterica16">My playlists</text>
		<texture>ui_button_ordinary</texture>
	</btn_playlists>

	<list_title x="264" y="240" width="406" height="28">
		<text font="letterica16" r="140" g="140" b="140" a="255" vert_align="c"/>
