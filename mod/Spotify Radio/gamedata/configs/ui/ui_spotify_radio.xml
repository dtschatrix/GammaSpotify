	</btn_prev>
	<btn_play x="672" y="148" width="48" height="30" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_start2</texture>
	</btn_play>
	<btn_pause x="672" y="148" width="48" height="30" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_stop2</texture>
	</btn_pause>
	<btn_next x="724" y="148" width="48" height="30" stretch="1">
