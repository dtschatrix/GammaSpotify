	<btn_page_next x="728" y="240" width="46" height="28" stretch="1" check_mode="0">
		<text font="letterica16">Next</text>
		<texture>ui_button_ordinary</texture>
	</btn_page_next>

	<!-- Row templates: the script creates one set per row and moves it into place. -->
	<row_text x="46" y="278" width="560" height="30">
		<text font="letterica16" r="200" g="200" b="200" a="255" vert_align="c"/>
	</row_text>
	<row_play x="622" y="280" width="72" height="26" stretch="1" check_mode="0">
		<text font="letterica16">Play</text>
		<texture>ui_button_ordinary</texture>
	</row_play>
	<row_queue x="700" y="280" width="72" height="26" stretch="1" check_mode="0">
		<text font="letterica16">Queue</text>
		<texture>ui_button_ordinary</texture>
