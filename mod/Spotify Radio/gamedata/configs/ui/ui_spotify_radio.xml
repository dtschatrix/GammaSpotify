	<search x="352" y="320" width="320" height="112" stretch="1">
		<background x="0" y="0" width="320" height="112" stretch="1">
			<texture>ui_inGame2_message_box</texture>
		</background>
		<caption x="16" y="10" width="288" height="20">
			<text font="letterica16" r="200" g="200" b="200" a="255" align="c" vert_align="c">Search Spotify</text>
		</caption>
		<input x="16" y="36" width="288" height="30" stretch="1">
			<text x="4" font="letterica16" vert_align="c" align="l"/>
			<texture>ui_inGame2_edit_box_2</texture>
		</input>
		<btn_ok x="84" y="76" width="72" height="28" stretch="1" check_mode="0">
			<text font="letterica16">Search</text>
			<texture>ui_button_ordinary</texture>
		</btn_ok>
		<btn_cancel x="164" y="76" width="72" height="28" stretch="1" check_mode="0">
			<text font="letterica16">ui_inv_cancel</text>
			<texture>ui_button_ordinary</texture>
		</btn_cancel>
	</search>
</w>
